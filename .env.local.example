# Copy this file to .env.local and fill in the values:   cp .env.local.example .env.local

# --- PostgreSQL ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# This default matches the docker-compose.yml in this project.
DATABASE_URL="postgresql://hotelynk:hotelynk@localhost:5432/hotelynk"
# Set to true only for hosted databases that require SSL (Neon, Supabase, Railway, RDS...).
DATABASE_SSL=false
# Optional: max connections this app keeps open (default 10 locally, 3 on Vercel).
# DATABASE_POOL_MAX=10

# --- Login sessions ---
# Secret used to sign login cookies. MUST be a long random string (32+ chars) and never shared.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=""

# --- Email (contact form) ---
# Free API key at https://resend.com
RESEND_API_KEY=""
