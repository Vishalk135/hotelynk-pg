{
  "name": "hotelynk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:seed": "node --env-file=.env.local scripts/seed.js",
    "db:init": "node --env-file=.env.local scripts/init-db.js",
    "db:reset": "node --env-file=.env.local scripts/init-db.js --reset",
    "db:setup": "npm run db:init && npm run db:seed",
    "db:migrate": "node --env-file=.env.local scripts/migrate.js",
    "admin:create": "node --env-file=.env.local scripts/create-admin.js",
    "db:init:prod": "node --env-file=.env.production.local scripts/init-db.js",
    "db:migrate:prod": "node --env-file=.env.production.local scripts/migrate.js",
    "admin:create:prod": "node --env-file=.env.production.local scripts/create-admin.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "jose": "^5.6.3",
    "lucide-react": "^0.383.0",
    "next": "14.2.35",
    "pdf-lib": "^1.17.1",
    "pg": "^8.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "resend": "^3.5.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "dotenv": "^16.4.5",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4"
  }
}
